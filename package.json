{
  "name": "hebrew-cursive-scanner",
  "version": "0.3.5",
  "description": "Scan handwritten Hebrew cursive notes and transcribe them into block print using the Gemini API.",
  "main": "src/main/main.js",
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "exifr": "^7.1.3",
    "heic-convert": "^2.1.0",
    "pdfjs-dist": "^6.3.289",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "playwright": "^1.63.0"
  },
  "build": {
    "appId": "com.ybrownstein.hebrewcursivescanner",
    "productName": "Hebrew Cursive Scanner",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ygb4520-cmd",
        "repo": "hebrew-cursive-scanner",
        "releaseType": "release"
      }
    ]
  }
}
